generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  difficulty   String?
  rating       Int        @default(800)
  onboarded    Boolean    @default(false)
  topics       UserTopic[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  socialAccounts SocialAccount[]

  @@map("users")
}

model Topic {
  id       String      @id @default(uuid())
  slug     String      @unique
  name     String
  category String?     @default("CORE")
  users    UserTopic[]

  @@map("topics")
}

model UserTopic {
  id      String @id @default(uuid())
  userId  String
  topicId String
   level   String  @default("easy") // <--- "easy", "medium", or "hard"

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topics")
}

// SocialAccount model to store social account information for users
model SocialAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  username       String?
  name           String?
  email          String?
  avatarUrl      String?
  profileUrl     String?
  bio            String?  @db.Text
  headline       String?
  stats          Json?
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@map("social_accounts")
}