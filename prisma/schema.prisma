generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String?
  onboarded Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  ratings UserTopicRating[]

  @@map("users")
}

model Topic {
  id String @id @default(uuid())
  slug String @unique
  name String
  active Boolean @default(true)
  ratings UserTopicRating[]

  @@map("topics")
}

model UserTopicRating {
  id String @id @default(uuid())
  userId String
  topicId String
  rating Int // 800 / 1200 / 1600

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topic_ratings")
}

model Session {
  id String @id @default(uuid())
  userId String
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AppConfig {
  key String @id
  value Json

  @@map("app_config")
}