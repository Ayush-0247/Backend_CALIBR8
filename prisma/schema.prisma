generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  difficulty   String?
  rating       Int        @default(800)
  onboarded    Boolean    @default(false)
  topics       UserTopic[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  socialAccounts SocialAccount[]

  @@map("users")
}

model Topic {
  id       String      @id @default(uuid())
  slug     String      @unique
  name     String
  category String?     @default("CORE")
  users    UserTopic[]

  @@map("topics")
}

model UserTopic {
  id      String @id @default(uuid())
  userId  String
  topicId String
   level   String  @default("easy") // <--- "easy", "medium", or "hard"

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topics")
}

// SocialAccount model to store social account information for users
model SocialAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  username       String?
  name           String?
  email          String?
  avatarUrl      String?
  profileUrl     String?
  bio            String?  @db.Text
  headline       String?
  stats          Json?
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@map("social_accounts")
}


model Problem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String     @unique
  title        String
  description  String
  difficulty   String?
  timeLimit    Int        @default(1000) @map("time_limit")
  memoryLimit  Int        @default(256) @map("memory_limit")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  testcases    Testcase[]
  @@map("problems")
}
model Testcase {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId     String  @map("problem_id") @db.Uuid
  testIndex     Int     @map("test_index")
  isVisible     Boolean @default(false) @map("is_visible")
  sizeBytes     Int     @map("size_bytes")
  stdinSmall    String? @map("stdin_small") @db.Text
  expectedSmall String? @map("expected_small") @db.Text
  r2InputKey    String? @map("r2_input_key")
  r2OutputKey   String? @map("r2_output_key")
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@index([problemId])
  @@map("testcases")
}